# Shared SigV4 credentials and region. Garage API keys start with `GK`.
BENCH_ACCESS_KEY=GKBENCHMARKACCESSKEY000000000000
BENCH_SECRET_KEY=benchmark-secret-key-change-me
BENCH_REGION=garage

# Pin all images to release versions to make runs reproducible.
FLASHS3_IMAGE=registry.garmingo.net/garmingo/flashs3/engine:v0.1.1
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
GARAGE_IMAGE=dxflrs/garage:v2.3.0
