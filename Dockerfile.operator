# FlashS3 operator image
#
# VERSION is set by GitLab CI from $CI_COMMIT_TAG (e.g. v0.2.0). The leading
# `v` is stripped so Cargo gets a semver package version.
FROM rust:1.93-bookworm AS builder
WORKDIR /app
ARG VERSION=0.2.1
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN VER="${VERSION#v}" \
    && sed -i "s/^version = \".*\"/version = \"${VER}\"/" Cargo.toml \
    && cargo build --release -p flash-s3-operator

FROM debian:bookworm-slim
ARG VERSION=0.2.1
LABEL org.opencontainers.image.version="${VERSION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/flash-s3-operator /usr/local/bin/flash-s3-operator
ENTRYPOINT ["flash-s3-operator"]
